<?xml version="1.0" encoding="utf-8"?>
<acrn-config>
  <hv>
    <BUILD_TYPE>debug</BUILD_TYPE>
    <FEATURES>
      <RELOC_ENABLED>y</RELOC_ENABLED>
      <SCHEDULER>SCHED_BVT</SCHEDULER>
      <MULTIBOOT2_ENABLED>y</MULTIBOOT2_ENABLED>
      <SPLIT_LOCK_DETECTION_ENABLED>n</SPLIT_LOCK_DETECTION_ENABLED>
      <UC_LOCK_DETECTION_ENABLED>n</UC_LOCK_DETECTION_ENABLED>
      <SECURITY_VM_FIXUP>n</SECURITY_VM_FIXUP>
      <HYPERV_ENABLED>n</HYPERV_ENABLED>
      <ACPI_PARSE_ENABLED>y</ACPI_PARSE_ENABLED>
      <L1D_VMENTRY_ENABLED>n</L1D_VMENTRY_ENABLED>
      <MCE_ON_PSC_ENABLED>y</MCE_ON_PSC_ENABLED>
      <CPU_PERFORMANCE_POLICY>Performance</CPU_PERFORMANCE_POLICY>
      <RDT>
        <RDT_ENABLED>n</RDT_ENABLED>
        <CDP_ENABLED>n</CDP_ENABLED>
        <VCAT_ENABLED>n</VCAT_ENABLED>
      </RDT>
      <KEEP_IRQ_DISABLED>n</KEEP_IRQ_DISABLED>
      <IOMMU_ENFORCE_SNP>n</IOMMU_ENFORCE_SNP>
    </FEATURES>
    <DEBUG_OPTIONS>
      <SERIAL_CONSOLE>/dev/ttyS4</SERIAL_CONSOLE>
      <MEM_LOGLEVEL>3</MEM_LOGLEVEL>
      <NPK_LOGLEVEL>3</NPK_LOGLEVEL>
      <CONSOLE_LOGLEVEL>3</CONSOLE_LOGLEVEL>
    </DEBUG_OPTIONS>
    <MEMORY>
      <STACK_SIZE>0x2000</STACK_SIZE>
    </MEMORY>
    <CAPACITIES>
      <MAX_PCI_DEV_NUM>256</MAX_PCI_DEV_NUM>
      <MAX_PT_IRQ_ENTRIES>256</MAX_PT_IRQ_ENTRIES>
      <MAX_MSIX_TABLE_NUM>130</MAX_MSIX_TABLE_NUM>
      <MAX_EMULATED_MMIO>16</MAX_EMULATED_MMIO>
      <MAX_VM_NUM>4</MAX_VM_NUM>
      <MAX_IOAPIC_NUM>1</MAX_IOAPIC_NUM>
      <MAX_IOAPIC_LINES>120</MAX_IOAPIC_LINES>
    </CAPACITIES>
    <MISC_CFG>
      <GPU_SBDF>0x00000010</GPU_SBDF>
    </MISC_CFG>
  </hv>
  <vm id="0">
    <lapic_passthrough>n</lapic_passthrough>
    <nested_virtualization_support>n</nested_virtualization_support>
    <vm_type>STANDARD_VM</vm_type>
    <console_vuart>COM Port 1</console_vuart>
    <os_config>
      <kern_type>KERNEL_BZIMAGE</kern_type>
      <kern_mod>Linux_bzImage</kern_mod>
      <bootargs>rw rootwait root=/dev/nvme0n1p2 console=tty0 console=ttyS0 consoleblank=0 no_timer_check quiet loglevel=3 i915.nuclear_pageflip=1 i915.force_probe=* i915.enable_guc=0x7</bootargs>
    </os_config>
    <load_order>SERVICE_VM</load_order>
    <name>VM0</name>
    <own_pcpu>n</own_pcpu>
    <priority>PRIO_LOW</priority>
    <companion_vmid>65535</companion_vmid>
  </vm>
  <vm id="1">
    <vm_type>STANDARD_VM</vm_type>
    <console_vuart>COM Port 1</console_vuart>
    <os_type>Non-Windows OS</os_type>
    <vuart0>n</vuart0>
    <vbootloader>y</vbootloader>
    <memory>
      <size>8192</size>
    </memory>
    <cpu_affinity>
      <pcpu>
        <pcpu_id>2</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>3</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>16</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>17</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>18</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>19</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
    </cpu_affinity>
    <customized_parameters>
    # GPU VF and display
    `add_passthrough_device                   2 0000:00:02.1`
    `add_virtual_device                       4 virtio-gpu lease=DP-3`

    # Storage
    `add_virtual_device                       3 virtio-blk /dev/nvme0n1p3`
    `add_virtual_device                       5 virtio-blk /dev/nvme0n1p4`

    # Touch
    `add_himax_touch                          6 himax-touchscreen_HMX2025`

    # Add virtio-net connection
    `add_virtual_device                       9 virtio-net tap=tap0,mac=00:16:3E:72:11:C5`

    # Passthrough AX99100 device
    `add_ax99100_devices                      12 2`
    </customized_parameters>
    <load_order>POST_LAUNCHED_VM</load_order>
    <name>RSE_L</name>
    <priority>PRIO_LOW</priority>
    <companion_vmid>65535</companion_vmid>
  </vm>
  <vm id="2">
    <vm_type>STANDARD_VM</vm_type>
    <console_vuart>COM Port 1</console_vuart>
    <os_type>Non-Windows OS</os_type>
    <vuart0>n</vuart0>
    <vbootloader>y</vbootloader>
    <memory>
      <size>8192</size>
    </memory>
    <cpu_affinity>
      <pcpu>
        <pcpu_id>2</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>3</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>16</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>17</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>18</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
      <pcpu>
        <pcpu_id>19</pcpu_id>
        <real_time_vcpu>n</real_time_vcpu>
      </pcpu>
    </cpu_affinity>
    <customized_parameters>
    # GPU VF and display
    `add_passthrough_device                   2 0000:00:02.2`
    `add_virtual_device                       4 virtio-gpu lease=DP-4`

    # Storage
    `add_virtual_device                       3 virtio-blk /dev/nvme0n1p3`
    `add_virtual_device                       5 virtio-blk /dev/nvme0n1p5`

    # Touch
    `add_himax_touch                          6 himax-touchscreen_HMX2026`

    # Add virtio-net connection
    `add_virtual_device                       9 virtio-net tap=tap1,mac=00:16:3E:D9:B2:3D`

    # Passthrough AX99100 device
    `add_ax99100_devices                      12 3`
    </customized_parameters>
    <load_order>POST_LAUNCHED_VM</load_order>
    <name>RSE_R</name>
    <priority>PRIO_LOW</priority>
    <companion_vmid>65535</companion_vmid>
  </vm>
  <vm id="3">
    <vm_type>STANDARD_VM</vm_type>
    <os_type>Non-Windows OS</os_type>
    <vuart0>n</vuart0>
    <vbootloader>y</vbootloader>
    <memory>
      <size>38912</size>
    </memory>
    <cpu_affinity>
      <pcpu>
        <pcpu_id>4</pcpu_id>
