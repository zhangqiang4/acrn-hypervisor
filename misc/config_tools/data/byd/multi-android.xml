    # Passthrough DG2
    `add_passthrough_device                   8 0000:03:00.0`

    # Add virtio-net connection
    `add_virtual_device                       9 virtio-net tap=tap3,mac=00:16:3E:EA:39:33`

    # Passthrough xDCI
    `add_passthrough_device                   10 0000:00:14.1`

    # Passthrough AX99100 device
    `add_ax99100_devices                      13 0`
    `add_ax99100_devices                      14 1`
    </customized_parameters>
    <load_order>POST_LAUNCHED_VM</load_order>
    <name>CSD_VM</name>
    <own_pcpu>y</own_pcpu>
    <priority>PRIO_LOW</priority>
    <companion_vmid>65535</companion_vmid>
  </vm>
</acrn-config>
