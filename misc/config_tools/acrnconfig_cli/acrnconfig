def invalid_param_if(condition, msg):
    if condition:
        raise ValueError(f"Invalid parameter: {msg}")

def get_or_create_at(etree_root, xpath):
    def create_element_at(root, xpath):
        for seg in xpath.strip('/').split('/'):
            e = root.find(seg)
            root = etree.SubElement(root, seg) if e is None else e
        return root

    element = etree_root.find(xpath)
    if element is None:
        element = create_element_at(etree_root, xpath)
    return element

class DummySchema:
    def validate(self, _, path):
        logging.debug("Validation Skipped")

    def find(self, path):
        raise FileNotFoundError("Unsupported action due to missing schema file")

class AcrnHV:
    def __init__(self, hv_etree, schema):
        self.hv = hv_etree
        self.schema = schema
        self.schema.validate(self.hv, path='acrn-config/hv')

    @classmethod
    def from_xml_file(cls, xmlfpath, schema):
        return cls(parse(xmlfpath), schema)

    @classmethod
    def from_empty(cls, schema):
        return cls(etree.ElementTree(etree.Element('hv')), schema)

    @classmethod
    def from_xml_str(cls, xml_str, schema):
        return cls(fromstring(xml_str), schema)

    def to_xml(self):
        etree.indent(self.hv, space="  ")
        return etree.tostring(self.hv, pretty_print=True).decode()

    def get_hv(self):
        return self.hv

    def get_schema_xpath(self, xpath):
        e = self.schema.find(path='acrn-config/hv/' + xpath)
        if e is None:
            raise ValueError(f"{xpath} is not a valid XML xpath")
        return e

    def get_default_from_schema(self, xpath):
        element = self.get_schema_xpath(xpath)
        if hasattr(element, 'default'):
            return element.default
        raise ValueError(f"Element {xpath} does not define a default value")

    def get_hv_prop(self, xpath):
        e = self.get_hv().find(xpath)
        if e is not None:
            logging.debug(f"Found {xpath} in local")
            return e.text
        logging.debug(f"Retrieve XSD default for {xpath}")
        return self.get_default_from_schema(xpath)

    def set_hv_prop(self, xpath, val):
        logging.debug("Setting HV prop: %s to %s", xpath, val)

        # Raise exception if xpath is invalid
        self.get_schema_xpath(xpath)

        root = copy.deepcopy(self.get_hv())
        element = get_or_create_at(root.getroot(), xpath)
        element.text = val
        self.schema.validate(self.get_hv(), path='acrn-config')
        # Validated
        self.hv = root

    def add_ivshmem(self, **kwargs):
        try:
            name = kwargs['name']
            src_vm = kwargs['src']
            dst_vm = kwargs['dst']
            src_bdf = kwargs['srcbdf']
            dst_bdf = kwargs['dstbdf']
            ivshm_size = kwargs['size']
            rid = kwargs['region_id']

            invalid_param_if(not re.compile(r'^[a-zA-Z0-9_]{1,27}$').match(name),
                             "Name can only be at most 27 letters, digits or underscore")
            for bdf in [src_bdf, dst_bdf]:
                invalid_param_if(not re.compile(r'^00:[0-9a-fA-F]{2}\.[0-9a-fA-F]$').match(bdf),
                                 'ACRN supports only bus 0 ivshmem: 00:<bb>.<f>')
            allowed_ivshmem_sizes = [str(2 ** p) + 'M' for p in range(1, 10)]
            invalid_param_if(ivshm_size not in allowed_ivshmem_sizes,
                             f"ivshmem size can only be one of: {', '.join(allowed_ivshmem_sizes)}")
            invalid_param_if(not re.compile('^[0-9]+$').match(rid), 'Region ID needs to be a number')

            ivshm_arr_root = get_or_create_at(self.get_hv(), 'FEATURES/IVSHMEM')
            ivshm = etree.SubElement(ivshm_arr_root, 'IVSHMEM_REGION')
            etree.SubElement(ivshm, 'NAME').text = name
            etree.SubElement(ivshm, 'PROVIDED_BY').text = 'Hypervisor'
            etree.SubElement(ivshm, 'IVSHMEM_SIZE').text = ivshm_size.replace('M', '')
            etree.SubElement(ivshm, 'IVSHMEM_REGION_ID').text = rid
            vms = etree.SubElement(ivshm, 'IVSHMEM_VMS')
            for vmname, bdf in [(src_vm, src_bdf), (dst_vm, dst_bdf)]:
                vm = etree.SubElement(vms, 'IVSHMEM_VM')
                etree.SubElement(vm, 'VM_NAME').text = vmname
                etree.SubElement(vm, 'VBDF').text = bdf
            self.schema.validate(self.get_hv(), path='acrn-config')
        except KeyError:
            raise ValueError("Invalid parameter. Please check help string of --add-ivshmem.")


class AcrnVM:
    def __init__(self, xml_root_element, schema):
        self.root = xml_root_element
        self.schema = schema
        logging.debug("Validating VM scenario")
        self.schema.validate(self.root, path='acrn-config')

    @classmethod
    def from_xml_str(cls, schema, xml_str):
        return cls(fromstring(xml_str), schema)

    @classmethod
    def from_xml_fpath(cls, schema, xmlpath):
        return cls(parse(xmlpath), schema)

    @classmethod
    def from_kwargs(cls, schema, **kwargs):
        kwargs = { k: v for k, v in kwargs.items() if v is not None }
        vm_name = kwargs['vm_name']
        vm_type = kwargs['vm_type']
        cpus = kwargs.get('cpus',None)
        memory = kwargs.get('memory', None)
        ktype = kwargs.get('kernel_type', None)
        initrd = kwargs.get('initrd', None)
        kargs = kwargs.get('kargs', None)
        host_devs = kwargs.get('host_devs', [])
        virt_devs = kwargs.get('virt_devs', [])
        vbootloader = kwargs.get('vbootloader', True)

        root = etree.Element('vm')
        etree.SubElement(root, 'name').text = vm_name
        etree.SubElement(root, 'vm_type').text = {
                'tee': 'TEE_VM',
                'pre-rt': 'RTVM',
                'post-rt': 'RTVM'
                }.get(vm_type, 'STANDARD_VM')
        etree.SubElement(root, "load_order").text = {
                'service': 'SERVICE_VM',
                'post': 'POST_LAUNCHED_VM',
                'post-rt': 'POST_LAUNCHED_VM',
                }.get(vm_type, 'PRE_LAUNCHED_VM')
        
        vm_obj = cls(root, schema)

        vm_obj.set_cpu(cpus)
        vm_obj.set_memory(memory)
        vm_obj.set_console_vuart()
        vm_obj.set_kernel_and_initrd(ktype, kargs, initrd)
        vm_obj.set_vbootloader(vbootloader)
        for dev in host_devs:
            vm_obj.add_pt_dev(dev)
        for dev in virt_devs:
            vm_obj.add_virt_dev(dev)
        return vm_obj
    
    def set_console_vuart(self, vuart='COM Port 1'):
        get_or_create_at(self.root, 'console_vuart').text = vuart
    
    def set_kernel_and_initrd(self, ktype, kargs, initrd):
        if self.get_load_order() != 'POST_LAUNCHED_VM':
            osconf_node = get_or_create_at(self.root, 'os_config')
            get_or_create_at(osconf_node, 'kern_type').text = "KERNEL_" + ktype.upper()
            get_or_create_at(osconf_node, 'kern_mod').text = {
                    'BZIMAGE': 'Linux_bzImage',
                    'ELF': 'kernel_elf',
                    'RAWIMAGE': 'kernel_raw',
                    }[ktype.upper()]
            if initrd:
                get_or_create_at(osconf_node, 'ramdisk_mod').text = 'Linux_initrd'
            get_or_create_at(osconf_node, 'bootargs').text = kargs

    def set_vbootloader(self, vbootloader):
        if self.get_load_order() == 'POST_LAUNCHED_VM' and vbootloader:
            get_or_create_at(self.root, 'vbootloader').text = 'y'
    
    def set_cpu(self, cpus):
        def cpustr2cpus(cpu_str):
            cpu_list = []
            for element in cpu_str.split(','):
                if '-' in element:
                    start, end = map(int, element.split('-'))
                    cpu_list.extend(range(start, end + 1))
                else:
                    cpu_list.append(int(element))
            return sorted(cpu_list)

        if self.get_load_order() != 'SERVICE_VM' and cpus is not None:
            logging.debug("%s: Setting CPUs to %s", self.get_name(), cpus)
            cpus_node = get_or_create_at(self.root, 'cpu_affinity')
            cpus_node.clear()
            for pcpuid in cpustr2cpus(cpus):
                etree.SubElement(etree.SubElement(cpus_node, 'pcpu'), 'pcpu_id').text = str(pcpuid)
    
    def set_memory(self, memory_str):
        def memorystr2memory(mem_str):
            if mem_str.endswith('G'):
                return str(int(int(mem_str.replace('G', '')) * 1024))
            if mem_str.endswith('M'):
                return mem_str.replace('M', '')
            raise ValueError("Unrecognized memory string")

        if self.get_load_order() != 'SERVICE_VM' and memory_str is not None:
            logging.debug("%s: Setting memory to %s", self.get_name(), memory_str)
            get_or_create_at(self.root, 'memory/size').text = memorystr2memory(memory_str)

    def add_pt_dev(self, dev_str):
        def host_dev_str_to_pcibdf(dev):
            parts = dev.split(':')
            if parts[0] != '0000':
                raise SystemError("ACRN supports only one PCI segment")
            return ':'.join(parts[1:])

        if self.get_load_order() != 'SERVICE_VM':
            dev_root = get_or_create_at(self.root, 'pci_devs')
            # The trailiing 'Passthrough Device' is needed
            # otherwise the vendor/device IDs are not generated properly
            etree.SubElement(dev_root, 'pci_dev').text = host_dev_str_to_pcibdf(dev_str) + ' Passthrough Device'

    def add_virt_dev(self, dev_str):
        def filter_params(params, allowed_params, domain):
            p1 = {k: v for k, v in params.items() if k not in allowed_params}
            p2 = {k: v for k, v in allowed_params.items() if v and k not in params}
            if len(p1) > 0:
                invalid_param_if(True, f"{domain}: Unknown parameter: {list(params.keys())[0]}")
            if len(p2) > 0:
                invalid_param_if(True, f"{domain}: Following parameters are required: {','.join(p2.keys())}")
            return params
        
        def add_virt_block(root, params):
            p = filter_params(params, {'img': True}, 'block')
            etree.SubElement(root, 'block').text = p['img']
        
        def add_virt_net(root, params):
            p = filter_params(params, {'virtio_framework': False, 'interface_name': False}, 'net')
            virtio_framework = p.get('virtio_framework', None)
            iface_name = p.get('interface_name', None)
            invalid_param_if(virtio_framework is not None and virtio_framework not in ['user', 'vhost'],
                             "net: virtio_framework can only be one of 'user' or 'vhost'")
            net = etree.SubElement(root, 'network')

            if virtio_framework:
                etree.SubElement(net, 'virtio_framework').text = {'vhost': 'Kernel based (Virtual Host)',
                    'user': 'User space based (VBSU)'}[virtio_framework]
            if iface_name:
                invalid_param_if(not re.compile(r'[a-zA-Z0-9-_]+').match(iface_name),
                                  'net: Please specify interface name using only letters, digits, hyphen or underscore')
                etree.SubElement(net, 'interface_name').text = iface_name
        
        def add_virt_input(root, params):
            p = filter_params(params, {'backend_device_file': True}, 'input')
            e = etree.SubElement(root, 'input')
            etree.SubElement(e, 'backend_device_file').text = p['backend_device_file']
        
        def add_virt_gpu(root, params):
            # TODO: window mode left as todo, as almost no one use windowed mode
            p = filter_params(params, {'fullscreen': False}, 'gpu')
            e = etree.SubElement(root, 'gpu')
            etree.SubElement(e, 'display_type').text = 'Full screen'
            displays = etree.SubElement(e, 'displays')
            for d in p['fullscreen'].split(':'):
                display = etree.SubElement(displays, 'display')
                etree.SubElement(display, 'monitor_id').text = d

        def add_virt_console(root, params):
            # TODO: In most cases console user uses default scenario.
            # parameters for console is left as a future todo.
            filter_params(params, {}, 'console')
            etree.SubElement(root, 'console')
        
        if self.get_load_order() != 'POST_LAUNCHED_VM':
            logging.warning("Adding virtual devices to non post launched VM. Ignoring.")
            return
        
        virtio_root = get_or_create_at(self.root, 'virtio_devices')
        parts = dev_str.strip().split(',')
        dev, params = parts[0], { p.split('=', 1)[0]: p.split('=', 1)[1] for p in parts[1:]}

        {
            'block': add_virt_block,
            'net': add_virt_net,
            'input': add_virt_input,
            'gpu': add_virt_gpu,
            'console': add_virt_console
        }.get(dev, lambda r, p: invalid_param_if(True, f"{dev}: Unknown virtual device type"))(virtio_root, params)

    def get_name(self):
        return self.root.xpath("name/text()")[0]

    def get_vm_type(self):
        return self.root.xpath("vm_type/text()")[0]

    def get_load_order(self):
        return self.root.xpath("load_order/text()")[0]

    def is_service_vm(self):
        return self.get_load_order() == 'SERVICE_VM'

    def get_host_devs(self):
        return self.root.xpath("pci_devs/pci_dev/text()")

    def get_xml_etree(self):
        return self.root

    def to_xml(self):
        etree.indent(self.root, space="  ")
        return etree.tostring(self.root, pretty_print=True).decode()

    def get_cpus(self):
        return self.root.xpath("cpu_affinity/pcpu/pcpu_id/text()")

    def get_memory(self):
        return self.root.xpath("memory/size/text()")[0]

    def to_str(self, verbosity=0):
        if verbosity == 0:
            s = "{: <20} {: <20}".format(self.get_name(), self.get_load_order())
        elif verbosity > 0:
            s = "{: >10} {: <20}".format("Name", self.get_name())
            s += "\n{: >10} {: <20}".format("VM type", self.get_load_order())
            s += "\n{: >10} {: <20}".format("CPUs",
                ','.join(self.get_cpus()) if not self.is_service_vm() else '(Non-prelaunched cores)')
            s += "\n{: >10} {: <20}".format("Memory",
                self.get_memory() if not self.is_service_vm() else '(Non-prelaunched memory)')
            for dev in self.get_host_devs():
                s += "\n{: >10} {: <20}".format("PCI devs", dev)
            vdevs = [vdev.tag for vdev in self.root.xpath("virtio_devices/*")]
            if vdevs:
                s += "\n{: >10} {: <20}".format("Virt Devs", ','.join(vdevs))
            s += "\n"
        return s

class AcrnScenario:
    def __init__(self, rootpath, create=False, name='scenario',
                 schema_dir=ACRNCONFIG_HV_DEFAULT_SCHEMA_DIR,
                 skip_schema_check=False):
        self.absroot = os.path.abspath(rootpath if rootpath else os.getcwd())
        self._config_file_name = ACRNCONFIG_CONF_FILE_NAME
        self.scn_file = os.path.join(self.absroot, self._config_file_name)

        schemaf = os.path.join(os.path.abspath(schema_dir), 'config.xsd')
        logging.debug("Schema file: %s", schemaf)
        if not os.path.isfile(schemaf):
            if skip_schema_check:
                self.schema = DummySchema()
            else:
                raise FileNotFoundError("""Schema file not found. Add --skip-schema-check to the base command (i.e., acrnconfig) to skip check. """)
        else:
            schema_etree = parse(schemaf)
            schema_etree.xinclude()
            self.schema = xmlschema.XMLSchema11(schema_etree)

        # Lazy init hv
        self.hv = None
        self.hv_xml = os.path.join(self.absroot, 'hv.xml')

        self.vm_objs = {}
        if create:
            self.meta = {
                    'name': name,
                    'vms': [],
                    'deploy_var': {}
                    }
        elif os.path.exists(self.scn_file):
            logging.debug("Using existing scenario meta: %s", "self.scn_file")
            with open(self.scn_file, 'r', encoding="utf-8") as f:
                self.meta = json.load(f)
            self.vm_objs = { name: AcrnVM.from_xml_fpath(self.schema, os.path.join(self.absroot, name + '.xml'))
                for name in self.meta['vms'] }
        else:
            raise FileNotFoundError(f"No {self._config_file_name} found under {self.absroot}. Aborting.")

    def has_vm(self, vm_name):
        return vm_name in self.vm_objs

    def get_vm(self, vm_name):
        if self.has_vm(vm_name):
            return self.vm_objs[vm_name]
        raise KeyError(f"VM with name {vm_name} does not exist")

    def get_vms(self):
        # Return a list, ordered by load_order.
        return sorted(self.vm_objs.values(), key=lambda x: {
            'PRE_LAUNCHED_VM': 0,
            'SERVICE_VM': 1,
            'POST_LAUNCHED_VM': 2
            }[x.get_load_order()])

    def save_vm_xml(self, vm_name):
        logging.debug("Saving VM %s", vm_name)
        with open(os.path.join(self.absroot, vm_name + '.xml'), 'w', encoding='utf-8') as f:
            f.write(self.get_vm(vm_name).to_xml())

    def add_vm(self, acrn_vm):
        vm_name = acrn_vm.get_name()
        if vm_name == 'hv':
            raise ValueError("'hv' is a reserved name. Please specify another VM name.")
        if not self.has_vm(vm_name):
            service_vm_list = list(filter(lambda x: x.get_load_order() == 'SERVICE_VM', self.vm_objs.values()))
            if acrn_vm.get_load_order() == 'POST_LAUNCHED_VM' and len(service_vm_list) == 0:
                raise ValueError(f"No Service VM found. Please add Service VM first.")

            if acrn_vm.get_load_order() == 'SERVICE_VM' and len(service_vm_list) > 0:
                raise ValueError(f"Service VM already exists. At most 1 Service VM is allowed")

            self.meta['deploy_var'][vm_name] = {}
            self.vm_objs[vm_name] = acrn_vm
        else:
            raise ValueError(f"VM with name {vm_name} already exists")

    def add_vm_from_kwargs(self, **kwargs):
        acrn_vm = AcrnVM.from_kwargs(self.schema, **kwargs)
        self.add_vm(acrn_vm)
        vm_name = acrn_vm.get_name()

        self.set_global(vm_name, 'kernel', kwargs.get('kernel', None))
        self.set_global(vm_name, 'initrd', kwargs.get('initrd', None))

    def import_vm(self, vm_xml_obj):
        vm = AcrnVM(vm_xml_obj, self.schema)
        vm_name = vm.get_name()
        if self.has_vm(vm_name):
            logging.error(f"VM name %s already exists.", vm_name)
            while True:
                resp = input("Choose action: [(R)eplace/(S)kip]: ")
                if resp.lower() == 'r':
                    self.del_vm(vm_name)
                    self.add_vm(vm)
                    break
                elif resp.lower() == 's':
                    logging.warning("Skip imported VM %s", vm_name)
                    break
                else:
                    logging.error("Unrecognized input. Type 'R' for replace or 'S' for Skip")
                    continue
        else:
            self.add_vm(vm)

    def del_vm(self, vm_name):
        if self.has_vm(vm_name):
            if vm_name in self.meta['deploy_var']:
                del self.meta['deploy_var'][vm_name]
            del self.vm_objs[vm_name]
        else:
            raise ValueError(f"VM with name {vm_name} does not exist")

    def update_vm_from_xml_str(self, vm_name, xml_str):
        new_vm = AcrnVM.from_xml_str(self.schema, xml_str)
        self.del_vm(vm_name)
        self.add_vm(new_vm)

    def import_hv(self, hv):
        self.hv = AcrnHV(hv, self.schema)

    def init_hv(self, create=False):
        if os.path.isfile(self.hv_xml) and not create:
            self.hv = AcrnHV.from_xml_file(self.hv_xml, self.schema)
        else:
            self.hv = AcrnHV.from_empty(self.schema)

    def get_hv(self):
        return self.hv.get_hv()

    def get_hv_prop(self, xpath):
        return self.hv.get_hv_prop(xpath)

    def set_hv_prop(self, xpath, val):
        self.hv.set_hv_prop(xpath, val)

    def hv_add_ivshmem(self, **kwargs):
        self.hv.add_ivshmem(**kwargs)

    def write_hv_to_disk(self):
        if self.hv is not None:
            logging.debug("Saving hv to disk")
            with open(self.hv_xml, 'w', encoding='utf-8') as f:
                f.write(self.hv.to_xml())

    def set_global(self, vm_name, key, val):
        if key and val:
            self.meta['deploy_var'][vm_name][key] = val

    def get_global(self, vm_name, key):
        return self.meta['deploy_var'][vm_name][key]

    def import_xml(self, xmlfpath):
        obj = parse(xmlfpath)
        self.import_hv(etree.ElementTree(obj.find('hv')))
        for vm in obj.findall('vm'):
            self.import_vm(vm)

    def export_xml(self, output):
        root = etree.Element('acrn-config')
        root.append(self.get_hv().getroot())
        for i, vm in enumerate(self.get_vms()):
            et = copy.deepcopy(vm.get_xml_etree()).getroot()
            et.set('id', str(i))
            root.append(et)
        with open(output, 'w', encoding='utf-8') as f:
            f.write(etree.tostring(root, pretty_print=True).decode())

    def deploy(self, acrn_src_dir, board_name):
        def run_command(cmd, basedir, errmsg):
            logging.info("Running command: %s", ' '.join(cmd))
            try:
                res = subprocess.run(cmd,
                    cwd=basedir,
                    capture_output=True,
                    text=True,
                    check=True)
                return res
            except subprocess.CalledProcessError as e:
                print(e.output)
                print(e.stderr)
                raise OSError(errmsg)

        def gen_board_xml(acrn_src_dir, board_name):
            board_inspector_path = f'{acrn_src_dir}/misc/config_tools/board_inspector/board_inspector.py'
            logging.info("Generating board xml")
            run_command(['python3', board_inspector_path, board_name], '.', 'Failed to generate board XML')

        def make_acrn(acrn_src_dir, board_file, scenario_file):
            logging.info("Building ACRN Hypervisor...")
            run_command(['make', 'clean'], acrn_src_dir, 'Failed to clean previous ACRN build')
            res = run_command(['make', '-j16',f'BOARD_FILE={board_file}', f'SCENARIO_FILE={scenario_file}'], acrn_src_dir, 'Failed to build ACRN')
            logging.debug(res.stdout.splitlines()[-1])
            return list(filter(lambda x: '.deb' in x, res.stdout.splitlines()[-1].split()))[0]

        logging.debug("ACRN source code path: %s", acrn_src_dir)
        logging.warning("Deploy command is meant to be used for testing purpose only.")
        logging.warning("For production scenario please refer to debian/README.rst in ACRN hypervisor source code.")
        scenario_file = ''
        with tempfile.NamedTemporaryFile(mode='w', delete=False) as tempf:
            scenario_file = tempf.name
            self.export_xml(output=scenario_file)
        gen_board_xml(acrn_src_dir, board_name)
        deb = make_acrn(acrn_src_dir, f'{os.getcwd()}/{board_name}.xml', scenario_file)
        os.remove(scenario_file)
        run_command(['mv', f'{acrn_src_dir}/build/{deb}', self.absroot], acrn_src_dir, "Failed to move deb packages")
        logging.info("Deb package generated: %s", deb)
        run_command(['apt', 'install', '-y', f'./{deb}'], self.absroot, "Failed to install deb package")

    def write_to_disk(self, meta=True, hv=True, vms='all'):
        logging.debug("Saving content to disk")
        if meta:
            self.meta['vms'] = [vm.get_name() for vm in self.get_vms()]
            with open(self.scn_file, 'w', encoding='utf-8') as f:
                json.dump(self.meta, f, indent=2)
        if hv:
            self.write_hv_to_disk()
        for vm in self.get_vms():
            if vms == 'all' or vm.get_name() in vms:
                self.save_vm_xml(vm.get_name())

def acrnconfig_logger_init(args):
    logging.basicConfig(format="[%(levelname)s] %(message)s")
    logger = logging.getLogger()
    logger.setLevel(args.loglevel.upper())

# Subcommands

def acrnconfig_init(args):
    if not args.force and \
        os.path.isfile(os.path.join(args.cpath if args.cpath else os.getcwd(), ACRNCONFIG_CONF_FILE_NAME)):
        while True:
            resp = input(f"File {ACRNCONFIG_CONF_FILE_NAME} already exists. Choose Action: (O)verwrite/(A)bort: ")
            if resp.lower() == 'o':
                logging.warning(f"Overwriting existing {ACRNCONFIG_CONF_FILE_NAME}")
                break
            elif resp.lower() == 'a':
                raise Exception("User aborted")
            else:
                logging.error("Unknown action")
    scn = AcrnScenario(args.cpath, create=True, name=args.scenario_name,
            schema_dir=args.schema_dir)
    if not args.create_empty:
        scn.init_hv(create=True)
        scn.set_hv_prop('BUILD_TYPE', 'debug')
        scn.set_hv_prop('DEBUG_OPTIONS/SERIAL_CONSOLE', '/dev/ttyS0')
        scn.add_vm_from_kwargs(vm_name='service-vm', vm_type='service', kernel_type='bzImage')
    scn.write_to_disk()

def acrnconfig_hv(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.init_hv()
    if args.set:
        k, v = args.set.split('=')
        scn.set_hv_prop(k, v)
        scn.write_hv_to_disk()
    elif args.get:
        print(scn.get_hv_prop(args.get))
    elif args.add_ivshmem:
        for ivshmem_str in args.add_ivshmem:
            params = { p.split('=', 1)[0]: p.split('=', 1)[1] for p in ivshmem_str.split(',') }
            invalid_param_if('src' not in params and 'dst' not in params, "Please specify src and dst vm name")
            invalid_param_if(not scn.has_vm(params['src']), f"VM {params['src']} does not exist")
            invalid_param_if(not scn.has_vm(params['dst']), f"VM {params['dst']} does not exist")
            scn.hv_add_ivshmem(**params)
        scn.write_hv_to_disk()
    else:
        raise ValueError("Unknown command")

def acrnconfig_addvm(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.add_vm_from_kwargs(vm_name=args.vm_name,
            vm_type=args.vm_type,
            cpus=args.cpus,
            memory=args.memory,
            host_devs=args.host_dev,
            virt_devs=args.virt_dev,
            kernel_type=args.kernel_type)
    scn.write_to_disk()

def acrnconfig_delvm(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.del_vm(args.vm_name)
    # Save only meta
    scn.write_to_disk(meta=True, hv=False, vms=[])

def acrnconfig_edit(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    vm = scn.get_vm(args.vm_name)

    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
        f.write(vm.to_xml())
        tempfpath = f.name

    while True:
        subprocess.run(['vim', tempfpath], check=True)
        with open(tempfpath, "r") as edited_f:
            newcontent = edited_f.read()
            try:
                scn.update_vm_from_xml_str(args.vm_name, newcontent)
                logging.info("XML validated")
                break
            except etree.XMLSyntaxError as e:
                logging.warning(e)
                response = input("Error detected. Retry editing? [Y/n] ")
                if response.lower() != 'y':
                    logging.warning("Abort editing.")
                    break
    os.remove(tempfpath)
    scn.write_to_disk(hv=False)

def acrnconfig_lsvm(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    for vm in scn.get_vms():
        if args.s is not None and args.s != vm.get_name():
            continue
        verbosity=0
        if args.v:
            verbosity=1
        print(vm.to_str(verbosity=verbosity))

def acrnconfig_deploy(args):
    if os.getuid() != 0:
        raise PermissionError("Please run 'deploy' as root")
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.init_hv()
    args.acrn_src = os.path.abspath(args.acrn_src)
    if os.path.isdir(args.acrn_src):
        scn.deploy(args.acrn_src, args.board_name)
    elif tarfile.is_tarfile(args.acrn_src):
        logging.debug("Tarball detected: %s", args.acrn_src)
        with tempfile.TemporaryDirectory() as temp_dir:
            with tarfile.open(args.acrn_src, 'r:*') as tar:
                tar.extractall(path=temp_dir)
            scn.deploy(temp_dir, args.board_name)
    elif zipfile.is_zipfile(args.acrn_src):
        logging.debug("Zipfile detected: %s", args.acrn_src)
        with tempfile.TemporaryDirectory() as temp_dir:
            with zipfile.open(args.acrn_src, 'r') as zip:
                zip.extractall(path=temp_dir)
            scn.deploy(temp_dir, args.board_name)
    elif os.path.isfile(args.acrn_src):
        raise FileNotFoundError(f"Unknown file format {args.acrn_src}")
    else:
        raise FileNotFoundError(f"Unable to access {args.acrn_src}")

def acrnconfig_import(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.import_xml(args.scenario_file)
    scn.write_to_disk()

def acrnconfig_export(args):
    scn = AcrnScenario(args.cpath, schema_dir=args.schema_dir, skip_schema_check=args.skip_schema_check)
    scn.init_hv()
    scn.export_xml(args.output)

def acrnconfig_plinfo(args):
    print(args)

def custom_type(regex, errmsg):
    def raise_exception(s):
        raise argparse.ArgumentTypeError(s)
    return lambda v: v if re.compile(regex).match(v) else raise_exception(errmsg)

def main():
    parser = argparse.ArgumentParser(description='ACRN Config CLI')
    subparsers = parser.add_subparsers(dest="command", required=True, help='Sub command help')

    parser.add_argument("-C", dest="cpath",
            help="Run as if acrnconfig was started in <path> instead of current directory.")
    parser.add_argument("--loglevel", default="info",
            choices=["debug", "info", "warning", "error", "critical"],
            help="Choose log level: debug, info, warning, error or critical")
    parser.add_argument("--schema-dir", default=ACRNCONFIG_HV_DEFAULT_SCHEMA_DIR,
            help="Directory containing ACRN XML Schema (config.xsd)")
    parser.add_argument("--skip-schema-check", default=False, action="store_true",
            help="Whether to skip schema check. Defaults to False.")

    parser_init   = subparsers.add_parser('init',   help='Init current directory as workspace')
    parser_hv     = subparsers.add_parser('hv',     help='Get/Set Hypervisor properties')
    parser_addvm  = subparsers.add_parser('addvm',  help='Add a Virtual Machine')
    parser_delvm  = subparsers.add_parser('delvm',  help='Delete a Virtual Machine')
    parser_edit   = subparsers.add_parser('editvm', help='Edit a Virtual Machine')
    parser_lsvm   = subparsers.add_parser('lsvm',   help='List configured Virtual Machines')
    parser_deploy = subparsers.add_parser('deploy', help='Deploy current settings')
    parser_import = subparsers.add_parser('import', help='Import an existing scenario')
    parser_export = subparsers.add_parser('export', help='Export current scenario')

    # init
    parser_init.set_defaults(func=acrnconfig_init)
    parser_init.add_argument("scenario_name", help="Scenario name")
    parser_init.add_argument("--force", help="Force init, regardless of whatever is already inside target folder",
                             action="store_true", default=False)
    parser_init.add_argument("--create-empty", action="store_true", default=False,
            help="Create an empty scenario")

    # hv
    parser_hv.set_defaults(func=acrnconfig_hv)
    hv_group = parser_hv.add_mutually_exclusive_group(required=True)
    hv_group.add_argument("--get", help="Get a hv property. Example: 'hv --get xmlpath'")
    hv_group.add_argument("--set",
            type=custom_type(r"^[a-zA-Z0-9/_-]+=[a-zA-Z0-9/_-]+$",
                "Unknown format. --set accepts 'key=val' format."),
            help="Set a hv property. Example: 'hv --set xmlpath=val'")
    ivshmem_help_str = "Example: --add-ivshmem name=<name>,src=myvm1,dst=myvm2,srcbdf=<bdf>,dstbdf=<bdf>,size=4M,region_id=<id>"
    hv_group.add_argument("--add-ivshmem",
            help="Add hv-land ivshmem. " + ivshmem_help_str,
            action='append',
            type=custom_type(r"\b([a-zA-Z0-9]+)=([a-zA-Z0-9_\-:.]+)\b(?:,\s*\b([a-zA-Z0-9]+)=([a-zA-Z0-9_\-:.]+)\b)*",
                             "Unknown ivshmem parameters. " + ivshmem_help_str))

    # addvm
    parser_addvm.set_defaults(func=acrnconfig_addvm)
    parser_addvm.add_argument("vm_name",
            type=custom_type(r"^[a-zA-Z0-9-_]{0,16}$",
                """At most 16 alphanumeric characters,
                hyphen and underscores are allowed for VM name"""),
            help="VM name. Contains at most 16 alphanumeric characters, hyphen or underscore.")
    parser_addvm.add_argument("--vm-type", default="post",
            choices=["service", "pre", "post", "tee", "pre-rt", "post-rt"],
            help="""VM type. Available choices: service, pre, post, tee.
            Defaults to 'post' if not specified.""")

    parser_addvm.add_argument("--cpus",
            type=custom_type(r"^([0-9]+(-[0-9]+)?)(,([0-9]+(-[0-9]+)?))*$",
                "Wrong CPU list format. Example: 2-5,7,9-11"),
            help="CPU sets that the VM can use")
    parser_addvm.add_argument("--memory",
            type=custom_type(r"^[0-9]+[GM]$", "Memory needs to be of format xG or xM."),
            help="Total memory of this VM")
    parser_addvm.add_argument("--host-dev",
            type=custom_type(
                r"^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-9a-fA-F]$",
                "Invalid host device format. Example: 0000:03:00.0"),
            action="append",
            help="Host PCI device to passthrough to this VM")
    parser_addvm.add_argument("--virt-dev",
            type=custom_type(r"^[a-zA-Z0-9/_-]+(,[a-zA-Z0-9/_-]+=[a-zA-Z0-9\:/_-]+)*$",
                "Invalid virtual device format. Example: virtdev,foo1=bar1,foo2=bar2"),
            action="append",
            help="""Virtual device to assign to this VM. Supports gpu, block, net, input, console (virtio)
            Examples:
                block,img=/path/to/img
                net,ifname=yaag
                input,backend_device_file=/dev/input/event5,id=0
                gpu,fullscreen=0:1:2
                console
            """)
    parser_addvm.add_argument("--kernel-type", help="Kernel image type",
            choices=["bzImage", "elf", "rawimage"], default="bzImage")
    parser_addvm.add_argument("--vbootloader", default=True, action="store_true",
            help="Enable vbootloader")
    parser_addvm.add_argument("--kargs", default="",
            help="Additional kernel command line arguments")

    # delvm
    parser_delvm.set_defaults(func=acrnconfig_delvm)
    parser_delvm.add_argument("vm_name", help="VM name to delete")

    # edit
    parser_edit.set_defaults(func=acrnconfig_edit)
    parser_edit.add_argument("vm_name", help="VM name to edit")

    # lsvm
    parser_lsvm.set_defaults(func=acrnconfig_lsvm)
    parser_lsvm.add_argument("-s", help="Show only information for VM <vm_name>")
    lsvm_group = parser_lsvm.add_mutually_exclusive_group()
    lsvm_group.add_argument("-v", action="store_true", help="Be a little bit verbose")

    # deploy
    parser_deploy.set_defaults(func=acrnconfig_deploy)
    parser_deploy.add_argument("--acrn-src",
            help="ACRN source code to be used. The path can be a folder that contains ACRN src, or a tarball/zipfile.",
            required=True)
    parser_deploy.add_argument("board_name", help="Board name to be deployed. For example, rpl-poc")

    # import
    parser_import.set_defaults(func=acrnconfig_import)
    parser_import.add_argument("scenario_file", help="Scenario file path to import")

    # export
    parser_export.set_defaults(func=acrnconfig_export)
    parser_export.add_argument("-o", "--output", default='exported_scenario.xml',
            help="Output file path. Defaults to 'export_scenario.xml' in current directory")

    args = parser.parse_args()

    acrnconfig_logger_init(args)

    args.func(args)

if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        print(f"{e}", file=sys.stderr)
        sys.exit(1)
